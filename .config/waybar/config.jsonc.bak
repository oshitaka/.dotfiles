[
  {
    //Main
    "include": "~/.config/waybar/modules",
    "layer": "top",
    "position": "top",
    "fixed-center": true,
    "height": 32,
    "spacing": 9,
    "margin-top": 8,
    "margin-left": 10,
    "margin-right": 10,
    "reload_style_on_change": true,

    "modules-left": ["hyprland/workspaces"],
    //"modules-left": ["custom/media"],

    //"modules-center": ["hyprland/window"],
    "modules-center": ["custom/cava", "custom/media", "custom/cava"],

    "modules-right": [
      "tray",
      "custom/weather",
      "group/main", 
      "hyprland/language",
		  "clock",
      "idle_inhibitor"
		]
  },

  {
    "include": "~/.config/waybar/modules",  
    "layer": "top",
    "position": "bottom",
    "height": 32,
    "spacing": 10,
    "fixed-center": true,
    "margin-bottom": 8,
    "margin-left": 10,
    "margin-right": 10,
    "reload_style_on_change": true,

    "modules-center": ["group/indicators"],
	  "modules-right": ["network#speed", "custom/vpn"]
  }
]

