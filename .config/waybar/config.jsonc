[
  {
    //Main
    "include": "~/.config/waybar/modules",
    "layer": "top",
    "position": "top",
    "fixed-center": true,
    "height": 32,
    "spacing": 9,
    "margin-top": 11,
    "margin-left": 12,
    "margin-right": 12,
    "reload_style_on_change": true,

    "modules-left": ["custom/separator_center", "custom/vpn", "group/indicators", "custom/separator_right"],
    //"modules-left": ["custom/media"],

    //"modules-center": ["hyprland/window"],
    "modules-center": ["custom/separator_left", "hyprland/workspaces", "custom/separator_right"],

    "modules-right": [
      "custom/separator_left",
      "tray",
      "custom/weather",
      "group/main", 
      "hyprland/language",
		  "clock",
      // "idle_inhibitor",
      "custom/separator_center"
		]
  }
]

