[
  {
    //Main
    "include": "~/.config/waybar/modules",
    "layer": "top",
    "position": "top",
    "fixed-center": true,
    "height": 32,
    "spacing": 9,
    "margin-top": 8,
    "margin-left": 10,
    "margin-right": 10,
    "reload_style_on_change": true,

    "modules-left": ["custom/vpn", "group/indicators"],
    //"modules-left": ["custom/media"],

    //"modules-center": ["hyprland/window"],
    "modules-center": ["hyprland/workspaces"],

    "modules-right": [
      "tray",
      "custom/weather",
      "group/main", 
      "hyprland/language",
		  "clock",
      "idle_inhibitor"
		]
  }
]

